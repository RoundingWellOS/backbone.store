{
  "name": "backbone.store",
  "version": "2.0.0",
  "description": "Store for keeping unique instance of Backbone models with ease.",
  "type": "module",
  "main": "dist/backbone.store.cjs",
  "module": "dist/backbone.store.mjs",
  "jsnext:main": "dist/backbone.store.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/backbone.store.js",
  "jsdelivr": "dist/backbone.store.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/backbone.store.mjs",
      "require": "./dist/backbone.store.cjs",
      "default": "./dist/backbone.store.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "browserslist": [
    ">0.5%",
    "Explorer >= 10",
    "not op_mini all"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "check": "npm run lint && npm run test && npm run build && npm run smoke",
    "coverage": "cross-env NODE_ENV=test c8 --include 'lib/**/*.js' --reporter=text --reporter=html mocha --config ./test/.mocharc.json",
    "lint": "eslint lib test",
    "lint:fix": "eslint --fix lib test",
    "smoke": "node test/smoke/esm.mjs && node test/smoke/cjs.cjs && node test/smoke/umd.cjs && node test/smoke/amd.cjs && tsc --noEmit -p test/smoke/tsconfig.json",
    "test": "mocha --config ./test/.mocharc.json",
    "test:watch": "mocha -w --config ./test/.mocharc.json",
    "watch": "tsdown --config-loader native --watch"
  },
  "repository": "RoundingWellOS/backbone.store",
  "keywords": [
    "backbone",
    "store",
    "model",
    "unique"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RoundingWellOS/backbone.store/issues"
  },
  "files": [
    "lib",
    "dist"
  ],
  "homepage": "https://github.com/RoundingWellOS/backbone.store#readme",
  "peerDependencies": {
    "backbone": "^1.3.3",
    "underscore": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/backbone": "^1.4.23",
    "@types/underscore": "^1.13.0",
    "backbone": "^1.6.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "mocha": "^11.7.5",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "underscore": "^1.13.8"
  }
}
